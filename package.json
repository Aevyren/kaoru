{
  "name": "kaoru",
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bunx oxlint --fix",
      "bunx prettier --write"
    ],
    "*.{json,css,md}": [
      "bunx prettier --write"
    ]
  },
  "private": true,
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "build": "bun --filter \"*\" build",
    "lint": "bun --filter \"*\" lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "prepare": "husky"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ]
}
